{
	"compilerOptions": {
		"composite": true,
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"target": "ES2022",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"types": ["node", "vite/client"],
		"jsx": "react-jsx",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"noEmit": true,
		"paths": {
			"@snout/review-core": ["../../packages/review-core/dist/index.d.ts"],
			"@snout/move": ["../../packages/move/dist/index.d.ts"],
			"@snout/liby/name": ["../../packages/liby-stub/studio/name.ts"],
			"@snout/liby": ["../../packages/liby-stub/src/index.ts"],
			"@snout/liby/studio": ["../../packages/liby-stub/studio/index.ts"],
			"@snout/studio/*": ["./src/*"],
			"@snout/studio-pro/renderer": ["../../packages/studio-pro-stub/renderer/index.tsx"],
			"@snout/studio-pro/wizard": ["../../packages/studio-pro-stub/renderer/FlowWizardView.tsx"],
			"@snout/studio-pro/vector-search": ["../../packages/studio-pro-stub/renderer/VectorSearchView.tsx"],
			"@snout/studio-pro/settings": ["../../packages/studio-pro-stub/renderer/settings.tsx"],
			"@snout/studio-pro/capabilities": ["../../packages/studio-pro-stub/renderer/capabilities.ts"],
			"react": ["./node_modules/@types/react"],
			"react/*": ["./node_modules/@types/react/*"],
			"react-dom": ["./node_modules/@types/react-dom"],
			"react-dom/*": ["./node_modules/@types/react-dom/*"],
			"three": ["./node_modules/@types/three"],
			"three/*": ["./node_modules/@types/three/*"]
		}
	},
	"include": [
		"src/renderer/**/*.ts",
		"src/renderer/**/*.tsx",
		"src/shared/**/*.ts",
		"../../packages/liby-stub/src/**/*.ts",
		"../../packages/liby-stub/studio/**/*.ts",
		"../../packages/studio-pro-stub/renderer/**/*.ts",
		"../../packages/studio-pro-stub/renderer/**/*.tsx"
	]
}
