<!-- Per-server macros. ReplicatedMergeTree's Keeper path and replica name are written with
     {shard}/{replica} by every real deployment and by the app's own DDL emitter, and without
     these a CREATE fails with "No macro 'shard' in config". -->
<clickhouse>
	<macros>
		<shard>01</shard>
		<replica>ch-b</replica>
		<cluster>default</cluster>
	</macros>
</clickhouse>
